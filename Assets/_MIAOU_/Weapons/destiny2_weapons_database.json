  "stats_definitions": {
    "Impact": "Determines the base damage output per projectile/hit.",
    "Range": "Extends effective range before damage falloff and improves bullet magnetism / aim assistance cone.",
    "Stability": "Reduces vertical recoil kick and reduces camera flinch when taking damage.",
    "Handling": "Controls weapon ready speed, stow speed, and Aim Down Sights (ADS) transition speed.",
    "Reload Speed": "Reduces the duration of the reload animation.",
    "Aim Assistance": "Determines bullet magnetism width and target acquisition strength.",
    "Zoom": "Magnification level when aiming down sights; scales effective damage falloff distance.",
    "Airborne Effectiveness": "Affects accuracy and bullet magnetism penalties while airborne.",
    "Recoil Direction": "Determines horizontal recoil tendency and predictability (ends in 5 for vertical recoil).",
    "RPM": "Rounds per minute (rate of fire).",
    "Charge Time": "Delay in milliseconds before a Fusion Rifle or Linear Fusion Rifle fires.",
    "Draw Time": "Time in milliseconds required to fully draw a Combat Bow string.",
    "Magazine": "Number of rounds loaded before needing a reload."
  },
